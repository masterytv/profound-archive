17:["$","div",null,{"className":"bg-muted/50 p-4 rounded-md text-sm space-y-2","children":[["$","p",null,{"className":"font-semibold","children":"Rating Guidance:"}],["$","ul",null,{"className":"list-disc pl-5 space-y-1","children":[["$","li",null,{"children":"\"I described it to my wife immediately when I woke up\" = strong if wife is referenced as confirmable witness"}],["$","li",null,{"children":"\"I remembered seeing this, and later found out it was true\" = weaker (when did they \"remember\" it?)"}],["$","li",null,{"children":"Look for phrases like \"the first thing I said when I woke up was...\""}],["$","li",null,{"children":"Medical staff surprised by accurate details they provided = evidence of temporal precedence"}],["$","li",null,{"children":"Written/recorded documentation > verbal claims"}]]}]]}]
18:["$","div",null,{"className":"space-y-4","children":[["$","h3",null,{"className":"text-xl font-semibold","children":"Critical Threshold Markers"}],["$","ul",null,{"className":"list-disc pl-5 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Strong Account Indicators"}]," (any of these significantly elevates evidential strength):",["$","ul",null,{"className":"list-circle pl-6 mt-1 space-y-1","children":[["$","li",null,{"children":"Criterion 1 ≥ 3 AND Criterion 5 ≥ 3 (severe medical crisis WITH specific verification)"}],["$","li",null,{"children":"Criterion 4 = 4 (information seemingly impossible to know)"}],["$","li",null,{"children":"Criterion 7 ≥ 3 (perception reported before verification possible)"}],["$","li",null,{"children":"Criterion 2 = 4 (remote perceptions)"}]]}]]}],["$","li",null,{"children":[["$","strong",null,{"children":"Limiting Factors"}]," (these cap overall evidential strength regardless of other scores):",["$","ul",null,{"className":"list-circle pl-6 mt-1 space-y-1","children":[["$","li",null,{"children":"Criterion 5 = 1 (no verification attempt) limits maximum practical evidential strength"}],["$","li",null,{"children":"Criterion 3 ≤ 2 (vague details) makes verification claims less meaningful"}],["$","li",null,{"children":"Criterion 6 = 1 (no verified perceptions) undermines the veridical nature of the claims"}]]}]]}]]}]]}]
