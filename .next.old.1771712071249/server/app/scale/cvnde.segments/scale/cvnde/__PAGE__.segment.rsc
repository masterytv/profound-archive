e:["$","section",null,{"className":"space-y-4 text-sm text-muted-foreground bg-muted/20 p-4 rounded-lg","children":[["$","h3",null,{"className":"font-semibold text-base text-foreground","children":"Notes on Scale Limitations"}],["$","p",null,{"children":"The cvNDE Scale assesses evidential strength of claims as presented—it does not and cannot determine whether claims are actually true. Key limitations include:"}],["$","ol",null,{"className":"list-decimal pl-5 space-y-1","children":[["$","li",null,{"children":"No independent verification: All verification claims come from the experiencer"}],["$","li",null,{"children":"Potential for selective reporting: Experiencers may share verified perceptions and omit errors"}],["$","li",null,{"children":"Memory considerations: Time between experience and recording affects recall"}],["$","li",null,{"children":"Presentation context: Interview format, audience, and platform may influence presentation"}]]}],["$","p",null,{"className":"mt-2 font-medium","children":"A high cvNDE score indicates an account WORTH INVESTIGATING further with the vNDE Scale methodology, not proof of veridical perception."}],["$","p",null,{"className":"mt-4 italic","children":"Scale developed as a companion to the vNDE Scale (Greyson et al., 2025) for preliminary assessment of first-person accounts."}]]}]
