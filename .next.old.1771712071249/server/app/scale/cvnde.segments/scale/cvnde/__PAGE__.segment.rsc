10:["$","div",null,{"className":"bg-muted/50 p-4 rounded-md text-sm space-y-2","children":[["$","p",null,{"className":"font-semibold","children":"Rating Guidance:"}],["$","ul",null,{"className":"list-disc pl-5 space-y-1","children":[["$","li",null,{"children":"Consider: \"Could someone lying in that position potentially have sensed this?\""}],["$","li",null,{"children":"Auditory information in the same room rates lower than visual details from impossible angles"}],["$","li",null,{"children":"Operating room perceptions with confirmed eye closure/anesthesia rate higher"}],["$","li",null,{"children":"Remote viewing (e.g., seeing family member at home) = highest rating"}],["$","li",null,{"children":"Perceptions of information on TOP of objects (like a number on top of a cabinet) when viewing from above rate higher than eye-level perceptions"}]]}]]}]
