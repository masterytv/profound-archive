12:["$","ul",null,{"className":"list-disc pl-5 space-y-1","children":[["$","li",null,{"children":"Numbers, proper names, and exact quotes rate highest"}],["$","li",null,{"children":"Details that would be impossible to guess (specific numbers on hidden objects, exact words of conversations) = 4"}],["$","li",null,{"children":"\"A doctor\" = low; “My anesthesiologist” = medium, \"Dr. Smith with the mustache\" = high"}],["$","li",null,{"children":"Unusual/unexpected details rate higher than expected ones"}],["$","li",null,{"children":"Multiple specific details can elevate rating even if individually moderate"}]]}]
