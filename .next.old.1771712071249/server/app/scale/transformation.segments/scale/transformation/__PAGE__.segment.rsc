0:{"buildId":"oyKcT-2Wdt29oHnyaeL87","rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-background text-foreground py-12 px-4 sm:px-6 lg:px-8","children":["$","div",null,{"className":"max-w-4xl mx-auto space-y-8","children":[["$","div",null,{"children":["$","$L2",null,{"href":"/search3","className":"inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition-colors mb-6","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-left w-4 h-4","aria-hidden":"true","children":[["$","path","1l729n",{"d":"m12 19-7-7 7-7"}],["$","path","x3x0zl",{"d":"M19 12H5"}],"$undefined"]}],"Back to Search"]}]}],["$","div",null,{"className":"space-y-4","children":[["$","h1",null,{"className":"text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100","children":"NDE Transformation Index (NDE-TI)"}],["$","p",null,{"className":"text-xl text-muted-foreground","children":"A Narrative-Analysis Scale for Measuring Post-NDE Transformation from First-Person Accounts"}]]}],["$","hr",null,{"className":"border-gray-200 dark:border-gray-800"}],["$","section",null,{"className":"space-y-4","children":[["$","h2",null,{"className":"text-2xl font-semibold","children":"Overview"}],["$","p",null,{"children":["Near-death experiences are not merely events that happen ",["$","em",null,{"children":"to"}]," people—they are events that fundamentally ",["$","em",null,{"children":"change"}]," people. This is one of the most robust and consistently replicated findings across five decades of NDE research."]}],["$","p",null,{"children":"The NDE Transformation Index (NDE-TI) is designed specifically for narrative analysis: it enables a trained reader or an AI system to evaluate the transformation described in a first-person account without requiring any additional investigation, survey completion, or follow-up contact with the experiencer. It extracts transformation evidence from what the experiencer chose to share, recognizing that this represents what was most salient and meaningful to them."}]]}],["$","section",null,{"className":"space-y-4","children":[["$","h2",null,{"className":"text-2xl font-semibold","children":"What the Scale Measures"}],["$","p",null,{"children":["The NDE-TI measures the transformation that an experiencer ",["$","em",null,{"children":"describes"}]," as resulting from their NDE, as expressed in their own account. It does not measure the depth or type of the NDE itself (that is the role of the ",["$","$L2",null,{"href":"/scale/greyson","className":"text-primary hover:underline","children":"Greyson NDE Scale"}],"). It does not verify whether changes actually occurred—it assesses what the experiencer reports."]}]]}],["$","section",null,{"className":"space-y-4","children":[["$","h2",null,{"className":"text-2xl font-semibold","children":"The Gap This Scale Addresses"}],["$","p",null,{"children":"Existing instruments (the Greyson NDE Scale, the Life Changes Inventory, Ring's Psychic Experiences Inventory) require the experiencer to complete a structured questionnaire. They cannot be applied retrospectively to narrative accounts—the thousands of interviews, testimonies, books, social media posts, and video transcripts that constitute the vast majority of available NDE data."}],["$","p",null,{"children":"The NDE-TI fills this gap by enabling systematic, comparable assessment of transformation from any first-person narrative source."}]]}],["$","section",null,{"className":"space-y-4","children":[["$","h2",null,{"className":"text-2xl font-semibold","children":"Design Principles"}],["$","ul",null,{"className":"list-disc pl-6 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Text-Derivable:"}]," Every element can be assessed from a first-person narrative without additional investigation."]}],"$L3","$L4","$L5","$L6","$L7"]}]]}],"$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e"]}]}],null,"$L1f"]}],"loading":null,"isPartial":false}
3:["$","li",null,{"children":[["$","strong",null,{"children":"Direction-Sensitive:"}]," Captures not just ",["$","em",null,{"children":"that"}]," change occurred, but ",["$","em",null,{"children":"which way"}]," it went."]}]
4:["$","li",null,{"children":[["$","strong",null,{"children":"Neutral on Valence:"}]," Does not assume transformation is positive or negative—captures what the experiencer reports."]}]
5:["$","li",null,{"children":[["$","strong",null,{"children":"Breadth and Depth:"}]," Distinguishes between wide-ranging transformation across many life areas and deep transformation in a single area."]}]
6:["$","li",null,{"children":[["$","strong",null,{"children":"Academically Grounded:"}]," Each domain maps to established constructs in the peer-reviewed NDE literature."]}]
7:["$","li",null,{"children":[["$","strong",null,{"children":"Intuitively Accessible:"}]," Described in language a high school student can understand."]}]
8:["$","hr",null,{"className":"border-gray-200 dark:border-gray-800"}]
9:["$","section",null,{"className":"space-y-4","children":[["$","h2",null,{"className":"text-2xl font-semibold","children":"Scale Structure"}],["$","p",null,{"children":["The NDE-TI consists of ",["$","strong",null,{"children":"10 Transformation Domains"}],", each scored on a ",["$","strong",null,{"children":"0–5 intensity scale"}],", with a direction indicator. The scale also generates three meta-scores and qualitative context notes."]}],["$","div",null,{"className":"relative w-full overflow-auto","children":["$","table",null,{"className":"w-full caption-bottom text-sm","children":[["$","thead",null,{"className":"[&_tr]:border-b","children":["$","tr",null,{"className":"border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted","children":[["$","th",null,{"className":"h-12 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0 w-[100px]","children":"Score"}],["$","th",null,{"className":"h-12 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0 w-[150px]","children":"Label"}],["$","th",null,{"className":"h-12 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0","children":"Description"}]]}]}],["$","tbody",null,{"className":"[&_tr:last-child]:border-0","children":[["$","tr",null,{"className":"border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted","children":[["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0 font-medium","children":"0"}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":"Not Addressed"}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":"This area of transformation is not discussed in the account"}]]}],["$","tr",null,{"className":"border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted","children":[["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0 font-medium","children":"1"}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":"Briefly Noted"}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":"A passing mention or slight implication of change"}]]}],["$","tr",null,{"className":"border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted","children":[["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0 font-medium","children":"2"}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":"Mild Change"}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":"A noticeable shift is described, with limited detail"}]]}],["$","tr",null,{"className":"border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted","children":[["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0 font-medium","children":"3"}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":"Moderate Change"}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":"A clear, meaningful transformation is described with some specific examples"}]]}],["$","tr",null,{"className":"border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted","children":[["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0 font-medium","children":"4"}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":"Significant Change"}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":"A major, life-altering transformation is described in detail; clearly important to the experiencer"}]]}],["$","tr",null,{"className":"border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted","children":[["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0 font-medium","children":"5"}],"$L20","$L21"]}]]}]]}]}],"$L22","$L23"]}]
