17:["$","section",null,{"className":"space-y-4","children":[["$","h2",null,{"className":"text-2xl font-semibold","children":"Scoring and Interpretation"}],["$","h3",null,{"className":"text-lg font-semibold","children":"Overall Transformation Score (0–50)"}],["$","p",null,{"children":"Sum of all 10 domain scores. Classifies the breadth and depth of transformation described in the account."}],["$","div",null,{"className":"relative w-full overflow-auto","children":["$","table",null,{"className":"w-full caption-bottom text-sm","children":[["$","thead",null,{"className":"[&_tr]:border-b","children":["$","tr",null,{"className":"border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted","children":[["$","th",null,{"className":"h-12 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0 w-[120px]","children":"Score Range"}],["$","th",null,{"className":"h-12 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0 w-[180px]","children":"Classification"}],["$","th",null,{"className":"h-12 px-4 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0","children":"Description"}]]}]}],["$","tbody",null,{"className":"[&_tr:last-child]:border-0","children":[["$","tr",null,{"className":"border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted","children":[["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0 font-medium","children":"0"}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":["$","span",null,{"className":"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200","children":"No Transformation"}]}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":"The account focuses on the NDE itself without describing aftereffects"}]]}],["$","tr",null,{"className":"border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted","children":[["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0 font-medium","children":"1–10"}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":["$","span",null,{"className":"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300","children":"Minimal Transformation"}]}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":"A few areas of change are briefly mentioned"}]]}],["$","tr",null,{"className":"border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted","children":[["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0 font-medium","children":"11–20"}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":["$","span",null,{"className":"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200","children":"Moderate Transformation"}]}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":"Several areas of meaningful change described"}]]}],["$","tr",null,{"className":"border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted","children":[["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0 font-medium","children":"21–30"}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":["$","span",null,{"className":"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-200","children":"Significant Transformation"}]}],["$","td",null,{"className":"p-4 align-middle [&:has([role=checkbox])]:pr-0","children":"Multiple areas of clear, substantial transformation described"}]]}],"$L24","$L25"]}]]}]